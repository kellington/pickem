{
  "name": "nfl-pickem",
  "version": "1.0.0",
  "description": "NFL Pick'em confidence league for a private friend group",
  "type": "module",
  "scripts": {
    "dev:server": "PORT=3001 tsx watch server/index.ts",
    "start:prod": "NODE_ENV=production PORT=5000 node --import=tsx/esm server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build",
    "start": "node --import=tsx/esm server/index.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed:teams": "tsx scripts/seed-teams.ts",
    "seed:season": "tsx scripts/seed-season.ts",
    "fetch:schedule": "tsx scripts/fetch-schedule.ts",
    "seed:games": "tsx scripts/seed-games.ts",
    "test": "tsx --test server/tests/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.10",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/memoizee": "^0.4.12",
    "@types/passport": "^1.0.17",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "connect-pg-simple": "^10.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "lucide-react": "^1.16.0",
    "memoizee": "^0.4.17",
    "openid-client": "^6.8.4",
    "passport": "^0.7.0",
    "pg": "^8.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "wouter": "^3.9.0",
    "zod": "^4.4.3"
  }
